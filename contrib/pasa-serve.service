# pasa serve, seeing only age files, its endpoint key and the pairings'
# transport keys: nothing that opens a version. First:
#   mkdir -p ~/.pasa/v ~/.pasa/give ~/.pasa/take
#   cp contrib/pasa-serve.service ~/.config/systemd/user/
#   systemctl --user enable --now pasa-serve
[Unit]
After=network-online.target

[Service]
ExecStart=%h/.cargo/bin/pasa serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
# The store's directory, less what opens it: `peers` and `id` are written
# by rename, which a file bound by itself refuses.
BindPaths=%h/.pasa
InaccessiblePaths=-%h/.pasa/key -%h/.pasa/dev -%h/.pasa/quick -%h/.pasa/ctap
BindReadOnlyPaths=%h/.cargo/bin/pasa

[Install]
WantedBy=default.target
