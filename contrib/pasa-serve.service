# pasa serve, seeing only store/v/ and net/: nothing that opens a version.
#   mkdir -p ~/.pasa/store/v ~/.pasa/net
#   cp contrib/pasa-serve.service ~/.config/systemd/user/
#   systemctl --user enable --now pasa-serve
[Unit]
After=network-online.target

[Service]
ExecStart=%h/.cargo/bin/pasa serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=%h/.pasa/store/v %h/.pasa/net
BindReadOnlyPaths=%h/.cargo/bin/pasa

[Install]
WantedBy=default.target
