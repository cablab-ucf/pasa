# pasa serve, seeing only v/ (age files) and net/ (its endpoint key, the
# pairings' transport keys, hand-overs): nothing that opens a version. Its
# network side confines itself to those two as well (Landlock). First:
#   mkdir -p ~/.pasa/v ~/.pasa/net
#   cp contrib/pasa-serve.service ~/.config/systemd/user/
#   systemctl --user enable --now pasa-serve
[Unit]
After=network-online.target

[Service]
ExecStart=%h/.cargo/bin/pasa serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=%h/.pasa/v %h/.pasa/net
BindReadOnlyPaths=%h/.cargo/bin/pasa

[Install]
WantedBy=default.target
